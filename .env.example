# ==============================================================================
# EARTHSCOPE — NASA Space Apps Challenge 2026 (Challenge 02: Trend Detective)
# ==============================================================================

# NASA Earthdata Login & Bearer Token (Register at https://urs.earthdata.nasa.gov)
EARTHDATA_BEARER_TOKEN=
EARTHDATA_USERNAME=

# NASA FIRMS Active Fire Map Key (Free key at https://firms.modaps.eosdis.nasa.gov/api/map_key)
FIRMS_MAP_KEY=

# NASA AppEEARS LP DAAC (https://appeears.earthdatacloud.nasa.gov)
APPEEARS_OAUTH_CLIENT_ID=
APPEEARS_TOKEN=

# UNEP-WCMC Protected Planet v4 (https://api.protectedplanet.net/request-token)
PROTECTED_PLANET_TOKEN=

# NASA POWER & Meteorological APIs
NASA_POWER_API_KEY=
NASA_CMR_SEARCH_URL=https://cmr.earthdata.nasa.gov/search/collections.json
NASA_POWER_MONTHLY_URL=https://power.larc.nasa.gov/api/temporal/monthly/point
NASA_GIBS_WMTS_URL=https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/wmts.cgi
NASA_FIRMS_API_URL=https://firms.modaps.eosdis.nasa.gov/api

# Open Public Geospatial Endpoints (No keys required)
OPEN_METEO_API_URL=https://archive-api.open-meteo.com/v1/archive
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
SOILGRIDS_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
COPERNICUS_STAC_URL=https://stac.dataspace.copernicus.eu/v1
EARTH_SEARCH_URL=https://earth-search.aws.element84.com/v1

# Optional Google Earth Engine Enhancement
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
